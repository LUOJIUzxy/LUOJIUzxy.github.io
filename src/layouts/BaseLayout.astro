---
import '../styles/global.css';
import { NEW_NOTE_URL, SHOW_DRAFTS } from '../lib/notes';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = '慢慢 · Phoebe｜给变化一点时间',
  description = 'Phoebe 的个人网站。记录心理治疗的心得、生活里的思考，以及技术与创作。',
} = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <header class="header">
      <a class="brand" href="/" aria-label="慢慢，返回首页">
        <span class="brand-mark">m.</span>
        <span>慢慢<span class="brand-separator">/</span><span class="brand-name">Phoebe</span></span>
      </a>
      <nav aria-label="主导航">
        <a href="/#notes">笔记</a>
        <a href="/#about">关于</a>
        {SHOW_DRAFTS && (
          <a class="write-button" href={NEW_NOTE_URL}>写一篇 <span aria-hidden="true">↗</span></a>
        )}
      </nav>
    </header>
    <main id="home">
      <slot />
    </main>
    <footer>
      <a class="footer-brand" href="/">慢慢 / Phoebe</a>
      <span>个人经历与思考 · 不作为诊断或治疗建议</span>
      <span>© {year} Phoebe</span>
    </footer>
  </body>
</html>
