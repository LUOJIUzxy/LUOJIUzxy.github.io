---
import '../styles/global.css';
import { NEW_NOTE_URL, SHOW_DRAFTS } from '../lib/notes';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'README.me · Phoebe',
  description = 'Phoebe 的个人网站。记录心理治疗的心得、生活里的观察，以及技术与创作。',
} = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0B0D" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600&display=swap"
    />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="README.me，返回首页">README.me</a>
        <nav aria-label="主导航">
          <a href="/#notes">笔记</a>
          <a href="/#about">关于</a>
          {SHOW_DRAFTS && (
            <a class="write-button" href={NEW_NOTE_URL}>写一篇 <span aria-hidden="true">↗</span></a>
          )}
        </nav>
      </div>
    </header>
    <main id="home">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>© {year} Phoebe</span>
        <span class="footer-sans">个人经历与思考 · 不作为诊断或治疗建议</span>
        <span class="footer-stack">astro · react · keystatic</span>
      </div>
    </footer>
  </body>
</html>
