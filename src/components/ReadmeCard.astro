---
/**
 * Hero visual: the site's own README.me, built from real data
 * (categories from the schema, counts and dates from published notes).
 */
import Frame from './Frame.astro';
import type { UI } from '../i18n';

interface Props {
  t: UI['readme'];
  tagline: string;
  categories: string[];
  published: number;
  updated: string | null;
  class?: string;
}
const { t, tagline, categories, published, updated, class: className } = Astro.props;

type Seg = [cls: 'h' | 'c' | 'k' | 'n' | 't', text: string];
const TOKEN: Record<Seg[0], string> = { h: 'text-fn', c: 'text-cmt', k: 'text-kw', n: 'text-num', t: 'text-fg' };
const lines: Seg[][] = [
  [['h', '# Phoebe']],
  [],
  [['c', `> ${tagline}`]],
  [],
  [['h', t.writing]],
  [],
  ...categories.map((c): Seg[] => [['k', '- '], ['t', c]]),
  [],
  [['h', t.status]],
  [],
  [['k', '- '], ['t', t.published], ['n', `\`${published}\``]],
  [['k', '- '], ['t', t.updated], ['n', `\`${updated ?? '—'}\``]],
  [['k', '- '], ['t', t.drafts]],
];
const source = lines.map((l) => l.map((s) => s[1]).join('')).join('\n');
---
<Frame class={className}>
  <figure>
    <figcaption class="relative flex min-h-11 items-center gap-3 border-b border-line pr-1 pl-4 font-mono">
      <span class="text-[13px] text-fg-2">README.me</span>
      <span class="ml-auto text-xs text-fg-3">Markdown</span>
      <button
        class="group inline-flex size-11 items-center justify-center text-fg-3 transition-colors hover:text-fg-2"
        type="button"
        aria-label={t.copy}
        data-copy={source}
        data-copied-label={t.copied}
      >
        <svg class="group-data-copied:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
        <svg class="hidden text-str group-data-copied:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
      </button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </figcaption>
    <pre
      class="overflow-x-auto py-[18px] pr-5 pb-[22px] font-mono text-[13px] leading-[1.6] [font-variant-ligatures:none] max-sm:[mask-image:linear-gradient(to_left,transparent,#000_24px)] sm:text-sm"
      lang="markdown"><code class="block min-w-max">{lines.map((segs, i) => (
      <span class="block min-h-[1.6em] whitespace-pre"><span class="inline-block w-8 pr-2.5 text-right text-fg-4 select-none sm:w-11 sm:pr-[18px]" aria-hidden="true">{i + 1}</span>{segs.map(([cls, text]) => <span class={TOKEN[cls]}>{text}</span>)}</span>
    ))}</code></pre>
  </figure>
</Frame>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let t: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      } catch {
        return;
      }
      btn.dataset.copied = '';
      if (status) status.textContent = btn.dataset.copiedLabel ?? '';
      clearTimeout(t);
      t = setTimeout(() => {
        delete btn.dataset.copied;
        if (status) status.textContent = '';
      }, 1600);
    });
  }
</script>
