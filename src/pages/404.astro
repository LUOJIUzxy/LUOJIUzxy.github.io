---
import BaseLayout from '../layouts/BaseLayout.astro';
const path = Astro.url.pathname;
---
<BaseLayout title="404 · README.me">
  <section class="wrap not-found">
    <div class="frame">
      <div class="frame-inner terminal">
        <p><span class="prompt" aria-hidden="true">$</span> <span class="cmd">open {path}</span></p>
        <p class="tok-err">open: {path}: no such file or directory</p>
      </div>
    </div>
    <a class="btn btn-primary" href="/">回到首页</a>
  </section>
</BaseLayout>
