---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadmeCard from '../components/ReadmeCard.astro';
import NotesBrowser, { type NoteSummary } from '../components/NotesBrowser';
import {
  CATEGORY_LABELS,
  NEW_NOTE_URL,
  SHOW_DRAFTS,
  excerptOf,
  formatDate,
  getVisibleNotes,
  plainText,
} from '../lib/notes';

const notes = await getVisibleNotes();
const summaries: NoteSummary[] = notes.map((n) => ({
  slug: n.id,
  title: n.data.title,
  date: formatDate(n.data.date, '-'),
  category: CATEGORY_LABELS[n.data.category],
  excerpt: excerptOf(n),
  searchText: plainText(n.body).slice(0, 3000),
  draft: n.data.status === 'draft',
}));

// The README card always reports the public state, even in local dev.
const published = (await getCollection('notes', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const updated = published[0] ? formatDate(published[0].data.date, '-') : null;

const about = (await getEntry('site', 'about'))?.data;
const categories = Object.values(CATEGORY_LABELS);

const prompts = [
  { key: '会谈之后', title: '今天，我带走了什么？', text: '一个有触动的片刻，一个新的理解，一个还想继续聊的问题。' },
  { key: '日常练习', title: '把理解，放进生活。', text: '记录一次与治疗师约定的练习，以及尝试前后的真实感受。' },
  { key: '偶尔回看', title: '有哪些细小的变化？', text: '留意重复出现的主题与变化，也允许有些问题暂时没有答案。' },
];
---
<BaseLayout>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="meta-line">~/phoebe · {published.length} 篇公开{updated && ` · 更新于 ${updated}`}</p>
      <h1 class="two-tone">
        你好，我是 Phoebe。
        <span>软件工程师。这是我的 README：治疗笔记、生活观察，和正在做的东西。</span>
      </h1>
      <div class="actions">
        <a class="btn btn-primary" href="#notes">读笔记</a>
        <a class="btn btn-secondary" href="#about">关于我</a>
      </div>
    </div>
    <ReadmeCard
      tagline={about?.heading ?? '写代码，也写下生活。'}
      categories={categories}
      published={published.length}
      updated={updated}
    />
  </section>

  <section class="section" id="notes">
    <div class="wrap">
      <div class="section-head">
        <h2 class="two-tone">笔记。<span>按主题筛选，或者直接搜。</span></h2>
        <div class="section-aside">
          <p>只有标成公开的笔记会出现在正式网站上。会谈里的理解，带回日常再看一遍。</p>
          <p class="index-line">01 notes/ →</p>
        </div>
      </div>
      <NotesBrowser
        client:load
        notes={summaries}
        categories={categories}
        writeUrl={SHOW_DRAFTS ? NEW_NOTE_URL : undefined}
      />
      {SHOW_DRAFTS && (
        <p class="local-note"><span class="tok-const">dev</span> 本地预览：草稿也会显示在这里；正式网站只显示状态为“公开”的笔记。</p>
      )}
    </div>
  </section>

  {SHOW_DRAFTS && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2 class="two-tone">不知道从哪里写？<span>借一个提纲开始。</span></h2>
          <div class="section-aside">
            <p>仅本地可见。完整提纲在编辑器“正文”字段的说明里。</p>
            <p class="index-line">02 prompts/ →</p>
          </div>
        </div>
        <dl class="def-list">
          {prompts.map((p) => (
            <a class="def-row" href={NEW_NOTE_URL}>
              <dt>{p.key}</dt>
              <dd>
                <span class="def-title">{p.title}</span>
                <span class="def-text">{p.text}</span>
              </dd>
              <span class="def-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </dl>
      </div>
    </section>
  )}

  <section class="section" id="about">
    <div class="wrap">
      <div class="section-head">
        <h2 class="two-tone">关于我。<span>{about?.heading}</span></h2>
        <div class="section-aside">
          <p>这一段在 Keystatic 的「关于我」里编辑。</p>
          <p class="index-line">{SHOW_DRAFTS ? '03' : '02'} about/ →</p>
        </div>
      </div>
      <div class="ruled-cols">
        {about?.paragraphs.map((p) => (
          <div class="ruled-col"><p>{p}</p></div>
        ))}
        {!!about?.tags.length && (
          <div class="ruled-col">
            <ul class="tags" aria-label="标签">
              {about.tags.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
