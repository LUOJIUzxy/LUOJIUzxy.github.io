---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import NotesBrowser, { type NoteSummary } from '../components/NotesBrowser';
import {
  CATEGORY_LABELS,
  NEW_NOTE_URL,
  SHOW_DRAFTS,
  excerptOf,
  formatDate,
  getVisibleNotes,
  plainText,
} from '../lib/notes';

const notes = await getVisibleNotes();
const summaries: NoteSummary[] = notes.map((n) => ({
  slug: n.id,
  title: n.data.title,
  date: formatDate(n.data.date),
  category: CATEGORY_LABELS[n.data.category],
  excerpt: excerptOf(n),
  searchText: plainText(n.body).slice(0, 3000),
  draft: n.data.status === 'draft',
}));

const about = (await getEntry('site', 'about'))?.data;

const prompts = [
  { no: '01 / 会谈之后', title: '今天，我带走了什么？', text: '一个有触动的片刻，一个新的理解，一个还想继续聊的问题。' },
  { no: '02 / 日常练习', title: '把理解，放进生活。', text: '记录一次与治疗师约定的练习，以及尝试前后的真实感受。' },
  { no: '03 / 偶尔回看', title: '有哪些细小的变化？', text: '留意重复出现的主题与变化，也允许有些问题暂时没有答案。' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-dot"></span> PERSONAL NOTES &amp; SMALL DISCOVERIES</div>
      <h1>给变化，<br />一点<span class="word-time">时间<svg viewBox="0 0 190 14" aria-hidden="true"><path d="M3 9Q80-2 184 5M12 12Q99 5 171 10"></path></svg></span>。</h1>
      <p class="hero-description">你好，我是 Phoebe。<br />这里记录心理治疗的心得，也留下生活、技术与创作里的思考。慢慢写，慢慢理解自己。</p>
      <div class="hero-actions">
        <a class="primary-link" href="#notes">翻开笔记 <span aria-hidden="true">↓</span></a>
        <a class="quiet-link" href="#about">认识我 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <HeroArt />
  </section>

  <div class="intro-strip">
    <span>观察 · 记录 · 回看</span>
    <p>不急着给每一种感受找到答案。</p>
    <span class="strip-number">01 — ongoing</span>
  </div>

  <section class="notes-section" id="notes">
    <div class="section-top">
      <div>
        <span class="eyebrow">THE NOTEBOOK</span>
        <h2>我的笔记<span class="heading-dot">.</span></h2>
      </div>
      <p>把会谈中的理解，带回日常。<br />也给新的想法留个位置。</p>
    </div>
    <NotesBrowser
      client:load
      notes={summaries}
      categories={Object.values(CATEGORY_LABELS)}
      writeUrl={SHOW_DRAFTS ? NEW_NOTE_URL : undefined}
    />
    {SHOW_DRAFTS && (
      <div class="local-note">
        <span class="tiny-dot"></span> 本地预览：草稿也会显示在这里；正式网站只显示状态为“公开”的笔记。
      </div>
    )}
  </section>

  {SHOW_DRAFTS && (
    <section class="prompts-section">
      <div class="prompt-intro">
        <span class="eyebrow">A PLACE TO START · 仅本地可见</span>
        <h2>不知道从哪里写？</h2>
        <p>给每周的记录一个轻一点的起点。完整提纲在编辑器“正文”字段的说明里。</p>
      </div>
      <div class="prompt-grid">
        {prompts.map((p) => (
          <a class="prompt" href={NEW_NOTE_URL}>
            <span class="prompt-no">{p.no}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <span class="prompt-link">开始写 <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="about-section" id="about">
    <div class="about-card">
      <div class="monogram" aria-hidden="true">P<span>✳</span></div>
      <div class="about-label">THE PERSON BEHIND THE NOTES</div>
    </div>
    <div class="about-copy">
      <span class="eyebrow">HELLO, I'M PHOEBE</span>
      <h2>{about?.heading}</h2>
      {about?.paragraphs.map((p) => <p>{p}</p>)}
      <div class="about-tags">{about?.tags.map((t) => <span>{t}</span>)}</div>
    </div>
  </section>

  <section class="closing">
    <span aria-hidden="true">✳</span>
    <p>留一点空间，<br />给正在成为的自己。</p>
    {SHOW_DRAFTS && <a class="text-button" href={NEW_NOTE_URL}>写下今天 <span aria-hidden="true">↗</span></a>}
  </section>
</BaseLayout>
